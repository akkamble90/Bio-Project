{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AssayAggregationEvent",
  "type": "object",
  "required": ["assay_id", "timestamp", "protein", "drug", "conditions", "label"],
  "properties": {
    "assay_id": {
      "type": "string",
      "pattern": "^EXP-AGGR-[0-9]{4}-[0-9]+$"
    },
    "timestamp": {
      "type": "integer",
      "description": "Epoch timestamp in seconds"
    },
    "protein": {
      "type": "object",
      "required": ["uniprot_id", "name", "sequence"],
      "properties": {
        "uniprot_id": {
          "type": "string",
          "pattern": "^[OPQ][0-9][A-Z0-9]{3}[0-9]|[A-NR-Z][0-9]([A-Z][A-Z0-9]{2}[0-9]){1,2}$"
        },
        "name": { "type": "string" },
        "sequence": {
          "type": "string",
          "pattern": "^[ACDEFGHIKLMNPQRSTVWY]+$"
        }
      }
    },
    "drug": {
      "type": "object",
      "required": ["chembl_id", "canonical_smiles"],
      "properties": {
        "chembl_id": { "type": "string" },
        "canonical_smiles": { "type": "string" },
        "molecular_weight": { "type": "number", "minimum": 0.0 }
      }
    },
    "conditions": {
      "type": "object",
      "required": ["temperature_celsius", "ph", "drug_concentration_umol"],
      "properties": {
        "temperature_celsius": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
        "ph": { "type": "number", "minimum": 0.0, "maximum": 14.0 },
        "drug_concentration_umol": { "type": "number", "minimum": 0.0 }
      }
    },
    "label": {
      "type": "object",
      "required": ["inhibition_percentage", "outcome"],
      "properties": {
        "inhibition_percentage": { "type": "number", "minimum": 0.0, "maximum": 100.0 },
        "outcome": {
          "type": "string",
          "enum": ["INHIBITOR", "AGGREGATOR", "INACTIVE"]
        }
      }
    }
  }
}